{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "python3",
        "/content/oc/config/.config/opencode/tools/memory_mcp.py",
        "--root",
        "/content/workspace/.memory"
      ],
      "cwd": "/content/workspace",
      "enabled": true,
      "timeout": 10000
    },
    "web": {
      "type": "local",
      "command": [
        "python3",
        "/content/oc/config/.config/opencode/tools/web_mcp.py"
      ],
      "cwd": "/content/workspace",
      "enabled": true,
      "timeout": 600000
    }
  }
}
