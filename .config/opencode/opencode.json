{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode/big-pickle",
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "python3",
        "/content/opencode-agent2/.memory/tools/memory_mcp.py",
        "--root",
        "/content/opencode-agent2/.memory"
      ],
      "cwd": "/content/opencode-agent2",
      "enabled": true,
      "timeout": 10000
    },
    "web": {
      "type": "local",
      "command": [
        "python3",
        "/content/opencode-agent2/my-opencode-config/.config/opencode/tools/web_mcp.py"
      ],
      "cwd": "/content/opencode-agent2",
      "enabled": true,
      "timeout": 600000
    }
  },
  "compaction": {
    "auto": false,
    "prune": true
  }
}
